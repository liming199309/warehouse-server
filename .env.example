# ===== 必填：钉钉微应用配置 =====
# 在钉钉开放平台 https://open-dev.dingtalk.com → 你的应用 → 基础信息 找
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# ===== 必填：Postgres 数据库（Neon 免费版） =====
# 在 https://neon.tech 创建项目后复制 connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ===== 必填：JWT 签名密钥（任意随机字符串） =====
JWT_SECRET=mulongshan-warehouse-secret-2026

# ===== 可选：上传图片目录 =====
# Render 强制 /tmp；本地默认 ./data/uploads
UPLOADS_DIR=
